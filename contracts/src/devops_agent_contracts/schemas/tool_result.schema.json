{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://devops-agent/contracts/tool_result.schema.json",
  "title": "ToolResult",
  "description": "Normalized shape for a single MCP tool call captured from a Claude Code run transcript.",
  "type": "object",
  "required": ["server", "tool", "input", "is_error", "timestamp"],
  "additionalProperties": false,
  "properties": {
    "server": { "type": "string", "minLength": 1 },
    "tool": { "type": "string", "minLength": 1 },
    "input": { "type": "object" },
    "output": {},
    "is_error": { "type": "boolean" },
    "error_message": { "type": "string" },
    "timestamp": { "type": "string", "format": "date-time" }
  }
}
